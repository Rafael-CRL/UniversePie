# Copie este arquivo para .env e preencha os valores.

# Provedor de IA usado para gerar os exercícios.
# Opções: gemini | groq | ollama | anthropic | deepseek | kimi | zai | openrouter | custom
AI_PROVIDER=gemini

# Opcional: modelo dentro do provedor. Vazio = padrão do provedor
# (gemini-2.5-flash, openai/gpt-oss-20b, qwen3:8b, claude-sonnet-5, ...).
AI_MODEL=

# Opcional: timeout das chamadas de geração, em segundos (padrão: 120).
# Modelos locais no Ollama usam 900s por padrão, independente deste valor.
AI_TIMEOUT_S=120

# Chave do provedor escolhido — só a do provedor em uso é obrigatória.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# Só para AI_PROVIDER=ollama (modelos locais; não precisa de chave)
OLLAMA_BASE_URL=http://localhost:11434

# Só para AI_PROVIDER=custom (qualquer endpoint compatível com a API da OpenAI:
# vLLM, llama.cpp, LM Studio, provedores não listados acima)
AI_BASE_URL=
AI_API_KEY=

# Opcional: nome do deck do Anki a ser usado (padrão: English_Series)
ANKI_DECK_NAME=English_Series
